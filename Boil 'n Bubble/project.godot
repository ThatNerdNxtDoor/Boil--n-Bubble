; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Boil 'n Bubble"
config/version="0.1.531"
run/main_scene="res://Scenes/World_Scenes/title_page.tscn"
config/features=PackedStringArray("4.4", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

PlayerInventory="*res://Scripts/Globals/player_inventory.gd"
SignalBus="*res://Scripts/Globals/signal_bus.gd"
GlobalSettings="*res://Scripts/Globals/GlobalSettings.gd"
SaveManager="*res://Scripts/Globals/save_manager.gd"

[display]

window/size/mode=2
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[global_group]

Persistent="Saved in the SaveDataFolder"

